@existsStudentId = 00000000-0000-0000-0000-000000000001
@notFoundStudentId = 00000000-0000-0000-0000-000000000000

### findStudentById_Success
GET {{api}}/v1/students/id/{{existsStudentId}}
Content-Type: application/json

> {%
    client.test("Scenario 1: SHOULD return student profile WHEN success", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

### findStudentById_NotFound
GET {{api}}/v1/students/id/{{notFoundStudentId}}
Content-Type: application/json

> {%
    client.test("Scenario 2: SHOULD return error message WHEN student ID not found", () => {
        client.assert(response.status === 404);

        client.assert(response.body !== null);
        client.assert(response.body.data === null);
        client.assert(response.body.message === "student.id.notFound");
    });
%}
