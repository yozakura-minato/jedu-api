### create_Success_HasPhoneNumber
POST {{host}}/{{api.v1}}
    /students
Content-Type: {{json}}

{
    "displayId": "STD1",
    "fullName": "Student One",
    "email": "std1@jedu.com",
    "phoneNumber": "0909090909",
    "password": "pw4std1"
}

> {%
    client.test("SHOULD return created id WHEN request is valid", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

