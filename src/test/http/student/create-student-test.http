### createStudent_Success_WithPhoneNumber
POST {{api}}/v1/students
Content-Type: application/json

{
  "displayId": "TESTA",
  "fullName": "Student A",
  "email": "student-a@jedu.com",
  "phoneNumber": "0900000000",
  "password": "password4student-a"
}

> {%
    client.test("Scenario 1: SHOULD return created student ID WHEN success with student phone number", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

