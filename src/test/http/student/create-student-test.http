### createStudent_DisplayId_Conflict
POST {{host}}/{{api.v1}}
    /students
Content-Type: {{json}}

{
    "displayId": "STD2",
    "fullName": "Student Three",
    "email": "std3@jedu.com",
    "phoneNumber": null,
    "password": "pw4std3"
}

> {%
    client.test("SHOULD return error message WHEN display id conflicts", () => {
        client.assert(response.status === 409);

        client.assert(response.body !== null);
        client.assert(response.body.data === null);
        client.assert(response.body.message === "student.displayId.conflict");
    });
%}

