@existsId = 01a109b6-bd84-7905-9715-e246fcc30a8e
@notFoundId = 00000000-0000-0000-0000-000000000000

### findStudentById_Success
GET {{api}}/v1/students/id/{{existsId}}
Content-Type: application/json

> {%
    client.test("SHOULD return  WHEN  is valid", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

### findStudentById_NotFound
GET {{api}}/v1/students/id/{{notFoundId}}
Content-Type: application/json

> {%
    client.test("SHOULD return  WHEN  is valid", () => {
        client.assert(response.status === 404);

        client.assert(response.body !== null);
        client.assert(response.body.data === null);
        client.assert(response.body.message === "student.id.notFound");
    });
%}
