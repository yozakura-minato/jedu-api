@validDisplayId = PE2601

### findProfileByDisplayId_Success
GET {{host}}/{{api.v1}}
    /employees/display-id/{{validDisplayId}}
Content-Type: {{json}}

> {%
    client.test("SHOULD return studentProfile WHEN displayId is valid", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.status === "SUCCESS");
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

### findProfileByDisplayId_DisplayIdNotTrimmed_WithHalfWidthWhiteSpace
GET {{host}}/{{api.v1}}
    /employees/display-id/{{space.half}}{{validDisplayId}}
Content-Type: {{json}}

> {%
    client.test("SHOULD return message WHEN displayId is not trimmed with half-width whitespace", () => {
        client.assert(response.status === 400);

        client.assert(response.body !== null);
        client.assert(response.body.status === "INVALID");
        client.assert(response.body.data === null);
        client.assert(response.body.message === "employee.displayId.notTrimmed");
    });
%}

### findProfileByDisplayId_DisplayIdNotTrimmed_FullWidthWhiteSpace
GET {{host}}/{{api.v1}}
    /employees/display-id/{{space.full}}{{validDisplayId}}
Content-Type: {{json}}

> {%
    client.test("SHOULD return message WHEN displayId is not trimmed with full-width whitespace", () => {
        client.assert(response.status === 400);

        client.assert(response.body !== null);
        client.assert(response.body.status === "INVALID");
        client.assert(response.body.data === null);
        client.assert(response.body.message === "employee.displayId.notTrimmed");
    });
%}

### findProfileByDisplayId_DisplayIdNotFound
GET {{host}}/{{api.v1}}
    /employees/display-id/NOT_FOUND
Content-Type: {{json}}

> {%
    client.test("SHOULD return message WHEN displayId is not found", () => {
        client.assert(response.status === 404);

        client.assert(response.body !== null);
        client.assert(response.body.status === "INVALID");
        client.assert(response.body.data === null);
        client.assert(response.body.message === "employee.displayId.notFound");
    });
%}
