@validId = 11111111-1111-1111-1111-111111111111
@notFoundId = 00000000-0000-0000-0000-000000000000

### findProfileByDisplayId_Success
GET {{host}}/{{api.v1}}
    /employees/id/{{validId}}
Content-Type: {{json}}

> {%
    client.test("SHOULD return profile WHEN id is valid", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

### findProfileByDisplayId_DisplayIdNotFound
GET {{host}}/{{api.v1}}
    /employees/id/{{notFoundId}}
Content-Type: {{json}}

> {%
    client.test("SHOULD return error message WHEN id is not found", () => {
        client.assert(response.status === 404);

        client.assert(response.body !== null);
        client.assert(response.body.data === null);
        client.assert(response.body.message === "employee.id.notFound");
    });
%}
