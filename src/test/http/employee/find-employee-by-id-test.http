@existsEmployeeId = 00000000-0000-0000-0000-000000000001
@notFoundEmployeeId = 00000000-0000-0000-0000-000000000000

### findEmployeeById_Success
GET {{api}}/v1/employees/id/{{existsEmployeeId}}
Content-Type: application/json

> {%
    client.test("Scenario 1: Success", () => {
        client.assert(response.status === 200);

        client.assert(response.body !== null);
        client.assert(response.body.data !== null);
        client.assert(response.body.message === null);
    });
%}

### findEmployeeById_IdNotFound
GET {{api}}/v1/employees/id/{{notFoundEmployeeId}}
Content-Type: application/json

> {%
    client.test("Scenario 2: Student display ID not found", () => {
        client.assert(response.status === 404);

        client.assert(response.body !== null);
        client.assert(response.body.data === null);
        client.assert(response.body.message === "employee.id.notFound");
    });
%}
